{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Service configuration",
  "description": "Settings for the example web service.",
  "type": "object",
  "required": ["name", "port", "logging"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "description": "Name shown in dashboards and logs." },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8080, "description": "TCP port the service listens on." },
    "environment": {
      "enum": ["development", "staging", "production"],
      "enumDescriptions": ["Local machine", "Pre-release testing", "Live traffic"],
      "default": "development",
      "description": "Which environment this configuration is for."
    },
    "logging": {
      "type": "object",
      "description": "Log output settings.",
      "properties": {
        "level": { "enum": ["debug", "info", "warning", "error"], "default": "info", "description": "Minimum severity to record." },
        "file": { "type": "string", "description": "Path of the log file. Leave out to log to the console." }
      }
    },
    "allowedHosts": {
      "type": "array",
      "items": { "type": "string", "format": "hostname" },
      "description": "Host names the service answers to."
    },
    "retries": { "type": "integer", "minimum": 0, "maximum": 10, "default": 3, "description": "How many times to retry a failed request." },
    "legacyMode": { "type": "boolean", "deprecationMessage": "No longer used; remove it." }
  }
}
